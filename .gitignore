# Estratégia: ignora TUDO por padrão e libera (!) só o código próprio.
# Isso evita que WordPress core, plugins/temas de terceiros, credenciais,
# uploads e backups acabem indo pro repositório por engano.

*
!.gitignore

# Código próprio: plugins customizados
!/wp-content/
/wp-content/*
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/falalouco-hoje-na-historia/
!/wp-content/plugins/falalouco-hoje-na-historia/**
!/wp-content/plugins/falalouco-setup/
!/wp-content/plugins/falalouco-setup/**

# Código próprio: tema filho customizado
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/falalouco-child/
!/wp-content/themes/falalouco-child/**
